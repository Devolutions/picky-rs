<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project exists to prove the generated bindings marshal correctly under
    the legacy .NET Framework CLR. The shipping assembly targets netstandard2.0,
    which loads on .NET Framework 4.x; here we compile the exact same generated
    sources against net48 and run the whole test suite on that runtime. The
    marshalling IL is identical either way, so a green run here is real evidence
    that Result/string/iterator returns survive the old CLR.

    We compile the sources directly instead of referencing Devolutions.Picky
    because that project also targets net9.0-ios, which would need the iOS
    workload just to resolve the reference.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Devolutions.Picky.Net48Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The generated bindings + hand-written addons, compiled under net48. -->
  <ItemGroup>
    <Compile Include="..\Devolutions.Picky\Generated\*.cs">
      <Link>Generated\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Devolutions.Picky\src\*.cs">
      <Link>Addons\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- The native library must sit next to the test assembly so DllImport finds it. -->
  <ItemGroup>
    <None Include="..\..\..\dependencies\runtimes\win-x64\native\DevolutionsPicky.dll">
      <Link>DevolutionsPicky.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
